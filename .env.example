# Copiá este archivo como .env y completá los valores.
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)

# --- Supabase ---
# URL y key del proyecto Supabase. En desarrollo local con la CLI, estos
# valores los imprime `supabase start` (usá la API URL y la service_role key).
# La service_role key es secreta: no debe exponerse al frontend.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=tu-service-role-key

# --- CORS ---
# Orígenes permitidos para el frontend (lista separada por comas).
# Opcional (default: * = todos). En producción restringir al dominio del front:
#   CORS_ORIGINS=https://gradebook-web.vercel.app,http://localhost:5000
CORS_ORIGINS=*

# --- Cache (Redis) ---
# TTL (segundos) del cache en Redis, uno por recurso. Es una red de seguridad:
# el cache se invalida explícitamente en cada escritura. Requiere las
# credenciales de Upstash de más abajo. Opcionales.
CACHE_TTL_ROLES=300
CACHE_TTL_CURSADAS=300
# Estudiantes cambian más seguido (altas/bajas/CSV); TTL corto + invalidación.
CACHE_TTL_ESTUDIANTES=60
CACHE_TTL_DOCENTES=300
CACHE_TTL_PERMISOS=600

# --- API key ---
# Restringe el consumo al frontend: si tiene valor, toda request debe enviar el
# header X-API-Key con esta clave. Vacío = API pública (sin key).
# Debe coincidir con la que configure el frontend. Generá una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# --- Rate limiting (Upstash Redis, opcional) ---
# Credenciales REST de Upstash. Si están vacías, el rate limiting queda
# deshabilitado (fail-open). Límite por IP: RATE_LIMIT_MAX requests por
# RATE_LIMIT_WINDOW segundos. Ojo: si el frontend es server-rendered, su
# tráfico comparte una sola IP, así que subí RATE_LIMIT_MAX en consecuencia.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# --- Configuración JWT ---
# Clave con la que se firman los tokens. En cualquier ambiente que no sea
# desarrollo local, usá una clave propia y larga. Podés generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-please
JWT_EXPIRACION_HORAS=8

# --- Autenticación ---
# El acceso es contra las tablas `docentes` / `estudiantes` (login por email +
# password bcrypt). No hay usuario admin por variables de entorno: los usuarios
# se crean con el seed de db/init_db.sql o vía los endpoints de gestión.

# --- reCAPTCHA v2 (checkbox "No soy un robot") ---
# Clave SECRETA con la que la API valida el token del widget contra Google
# (POST a https://www.google.com/recaptcha/api/siteverify). La site key pública
# la configura el frontend (gradebook-web → RECAPTCHA_SITE_KEY); este secret es
# su par y NO debe exponerse. Generá ambas en https://www.google.com/recaptcha/admin
# Para desarrollo podés usar el secret de test de Google (siempre valida):
#   6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Si está en true, se saltea la verificación del captcha (útil para tests
# automatizados). NO usar en producción. Opcional (default: false).
RECAPTCHA_DISABLED=false

# --- Recuperación de contraseña ---
# Base del frontend para armar el link del email:
#   FRONTEND_URL/admin/cambiar-contrasena?token=...
FRONTEND_URL=http://localhost:5001

# TTL (segundos) del token de un solo uso (default 1800 = 30 min). Requiere Upstash.
PASSWORD_RESET_TTL=1800

# --- Asistencia (envío de QRs por lotes) ---
# Cuántos QRs se envían por request (el front empuja de a lotes con el polling,
# para no exceder el timeout serverless) y cuántos reintentos por email.
ASISTENCIA_LOTE_EMAILS=15
ASISTENCIA_MAX_INTENTOS_ENVIO=3

# --- Email (Flask-Mail / SMTP) ---
# Se usa para enviar el link de recuperación. Si MAIL_USERNAME/MAIL_PASSWORD están
# vacíos (o MAIL_SUPPRESS_SEND=true), NO se envía: se loguea el link (modo dev).
# Con Gmail, MAIL_PASSWORD es un "App Password" (no la clave de la cuenta).
# Ojo: muchas redes corporativas/VPN bloquean el puerto 587 (SMTP).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
# Remitente. Si se deja vacío, usa MAIL_USERNAME (Gmail exige que el from sea la
# cuenta autenticada).
MAIL_DEFAULT_SENDER=
MAIL_SUPPRESS_SEND=false
